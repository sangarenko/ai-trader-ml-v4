$ sqlite3 -header -column /opt/ai-trader/db/trader.db "
SELECT ticker,
       COUNT(*) AS n,
       ROUND(SUM(pnl),2) AS total_pnl,
       ROUND(AVG(pnl),3) AS avg_pnl,
       ROUND(SUM(CASE WHEN pnl>0 THEN 1.0 ELSE 0 END)/COUNT(*),3) AS win_rate
FROM Trade
GROUP BY ticker
ORDER BY total_pnl ASC;
"
